# Same Supabase project as the SCULPT mobile app (EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_ANON_KEY).
# Origin only, no trailing slash.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Optional. email_alias (default) or phone. Must match the mobile app.
# NEXT_PUBLIC_AUTH_LOGIN_MODE=email_alias
# NEXT_PUBLIC_AUTH_ALIAS_EMAIL_DOMAIN=phone.sculpt.studio

# Never put the service-role key here or in any NEXT_PUBLIC_* variable.
